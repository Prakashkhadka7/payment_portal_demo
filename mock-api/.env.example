# Password shared by all seeded demo users (min 8 characters).
SEED_USER_PASSWORD=

# Port the mock API listens on. The Angular dev server proxies /api to it 
MOCK_API_PORT=3000

# Access token lifetime. Kept short so the refresh flow is easy to observe.
ACCESS_TOKEN_TTL_SECONDS=60

# Refresh token (httpOnly cookie) lifetime.
REFRESH_TOKEN_TTL_SECONDS=28800

# Artificial latency per data request, to make loading states visible.
MOCK_LATENCY_MS=500

# Probability (0-1) that a data request fails with 503, to exercise error/retry states.
MOCK_FAILURE_RATE=0

# Set to true when served over HTTPS so the refresh cookie gets the Secure flag.
COOKIE_SECURE=false

# Login rate limiting: after LOGIN_MAX_FAILURES failed attempts for a username, further attempts are
# blocked for LOGIN_LOCKOUT_SECONDS (also the window in which failures are counted).
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_SECONDS=300
