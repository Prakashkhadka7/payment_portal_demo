{
  "name": "payment-portal",
  "version": "0.0.0",
  "private": true,
  "packageManager": "npm@10.9.9",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "ng": "ng",
    "start": "node scripts/ng-with-env.mjs serve",
    "mock:api": "node --watch mock-api/src/server.ts",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors blue,magenta \"npm:mock:api\" \"npm:start\"",
    "build": "node scripts/ng-with-env.mjs build",
    "watch": "node scripts/ng-with-env.mjs build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "lint": "ng lint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@angular/cdk": "^22.2.2",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/material": "^22.2.2",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "lodash-es": "^4.18.1",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.2",
    "@angular/cli": "^22.2.2",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.20.5",
    "angular-eslint": "22.5.0",
    "concurrently": "^10.0.6",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^5.0.0"
  }
}
